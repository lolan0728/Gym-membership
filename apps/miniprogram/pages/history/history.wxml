<view class="page"><text class="eyebrow">YOUR JOURNEY</text><text class="title">每一段，都算数</text><text class="subtitle">你的开卡、续卡与调整记录，都在这里。</text><view wx:if="loading" class="loading">正在加载…</view><view wx:elif="error"><view class="error-box">{{error}}</view><button class="secondary" bindtap="load">重试</button></view><block wx:else><view class="section" wx:for="cards" wx:key="id"><view class="row"><text class="history-kind">{{item.eventLabel}} · {{item.kindLabel}}</text><text class="pill {{item.status}}">{{item.statusLabel}}</text></view><text class="history-period">{{item.period}}</text><text wx:if="item.void_reason" class="void-reason">作废原因：{{item.void_reason}}</text></view><view wx:if="!cards.length" class="loading">暂无办卡记录</view></block><view class="footer">KEEP SHOWING UP.</view></view>

<privacy-dialog id="privacy-dialog" />
