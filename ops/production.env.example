# Copy to project root as .env on the production server only. Never use local demo data in production.
NODE_ENV=production
SITE_DOMAIN=members.your-domain.cn
ACME_EMAIL=owner@your-domain.cn
ADMIN_ORIGIN=https://members.your-domain.cn
PUBLIC_URL=https://members.your-domain.cn
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
WECHAT_APP_ID=wx_REPLACE
WECHAT_APP_SECRET=REPLACE
WECHAT_QRCODE_ENV=release
COS_SECRET_ID=REPLACE
COS_SECRET_KEY=REPLACE
COS_BUCKET=gym-assets-REPLACE
COS_REGION=ap-shanghai
COS_PREFIX=production
# Use a separate, private bucket and independently restricted credentials for backups.
BACKUP_COS_SECRET_ID=REPLACE
BACKUP_COS_SECRET_KEY=REPLACE
BACKUP_COS_BUCKET=gym-backup-REPLACE
BACKUP_COS_REGION=ap-shanghai
BACKUP_PREFIX=gym-production/
BACKUP_KEY_HEX=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Store an offline copy of the encryption key; losing it makes restores impossible.
# Optional webhook accepts {"text":"..."}; leave blank until your alert service is configured.
ALERT_WEBHOOK_URL=
