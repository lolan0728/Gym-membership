.backdrop{position:fixed;inset:0;background:#18332999;display:flex;align-items:center;justify-content:center;z-index:9999;padding:44rpx}.dialog{background:#fff;border-radius:28rpx;padding:42rpx 36rpx;width:100%;box-sizing:border-box}.title{display:block;font-size:32rpx;font-weight:600;color:#274535;margin-bottom:26rpx}.copy{font-size:25rpx;color:#87987b;line-height:1.9}.contract{display:block;font-size:25rpx;color:#3f7141;line-height:2;margin:12rpx 0 30rpx}.actions{display:flex;gap:18rpx}.actions button{flex:1;margin:0;border-radius:14rpx;font-size:24rpx;padding:8rpx 0}.actions button::after{border:0}.decline{background:#f1f4eb;color:#839476}.accept{background:#234f3c;color:#fff}
