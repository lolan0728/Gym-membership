{
  "name": "gym-membership",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/admin",
    "apps/miniprogram"
  ],
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "concurrently -k -n api,admin \"npm run dev -w @gym/api\" \"npm run dev -w @gym/admin\"",
    "build": "npm run build -w @gym/api && npm run build -w @gym/admin && npm run check -w @gym/miniprogram",
    "test": "npm run test -w @gym/api",
    "test:ui": "node scripts/ui-test.mjs",
    "seed:demo": "npm run seed:demo -w @gym/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  }
}
