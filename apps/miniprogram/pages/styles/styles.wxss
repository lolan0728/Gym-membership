.preview{margin:42rpx 0}.themes{display:grid;grid-template-columns:1fr 1fr;gap:22rpx;margin-bottom:40rpx}.theme-option{border:2rpx solid #e5eadd;border-radius:18rpx;padding:18rpx;background:#fff}.theme-option.selected{border-color:#668b45;background:#f5f8ee}.swatch{height:135rpx;border-radius:12rpx;background:linear-gradient(110deg,#202925,#3d4031);color:#ead69e;display:flex;align-items:center;justify-content:space-between;padding:20rpx 25rpx;font-size:60rpx}.swatch.blue{background:linear-gradient(110deg,#152b4b,#314e79);color:#d1def4}.swatch.orange{background:linear-gradient(110deg,#db672e,#f39449);color:#fff2da}.swatch.white{background:linear-gradient(110deg,#f5f1e9,#e8e8de);color:#424f44}.chosen{font-size:26rpx}.theme-name{display:block;font-size:23rpx;margin:20rpx 0 8rpx}.theme-hint{font-size:18rpx;color:#a6b095}.save-note{display:block;text-align:center;color:#a6b095;font-size:20rpx;margin-top:23rpx}
