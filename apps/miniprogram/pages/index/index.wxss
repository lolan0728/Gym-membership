.store-heading{display:flex;align-items:center;height:100rpx}.store-logo{display:block;width:273rpx;height:100rpx;object-fit:contain}.mark{background:#015556;color:#fff;border-radius:13rpx;width:64rpx;height:64rpx;display:flex;align-items:center;justify-content:center;font-size:30rpx}.welcome{display:flex;align-items:center;justify-content:space-between;margin:54rpx 0 36rpx}.welcome .title{font-size:42rpx;margin-top:10rpx}.welcome .subtitle{font-size:21rpx}.avatar-button{width:92rpx;height:92rpx;min-width:92rpx;border-radius:50%;background:#e6edda;color:#8da37b;margin:0 0 0 15rpx;padding:0;overflow:visible;display:flex;align-items:center;justify-content:center;font-size:32rpx;line-height:1}.avatar-button image{width:100%;height:100%;border-radius:50%}.avatar-edit{position:absolute;right:-3rpx;bottom:-4rpx;width:29rpx;height:29rpx;font-size:21rpx;background:#015556;color:white;border:4rpx solid #f7f8f2;border-radius:50%;display:flex;align-items:center;justify-content:center}.customize{display:flex;align-items:center;gap:20rpx;margin-top:35rpx;padding:30rpx 28rpx;border-radius:19rpx;background:#eaf0df}.custom-title{display:block;font-size:25rpx;color:#566f3f}.custom-sub{display:block;font-size:19rpx;color:#98a786;margin-top:9rpx}.color-dots{display:flex;margin-left:auto;padding-left:10rpx}.color-dots view{width:29rpx;height:29rpx;background:#4a5140;border:3rpx solid #eaf0df;border-radius:50%;margin-left:-8rpx}.color-dots view:nth-child(2){background:#4e658b}.color-dots view:nth-child(3){background:#de8b51}.chevron{color:#90a273;font-size:36rpx}.menu{padding:0 30rpx}.menu-item{padding:31rpx 0;display:flex;justify-content:space-between;border-bottom:1rpx solid #eef1e7;font-size:24rpx;color:#667b54}.menu-item:last-child{border:0}.menu-item text:last-child{color:#afbaa2;font-size:31rpx;line-height:1}.upcoming-row{padding:12rpx 0 24rpx;border-bottom:1rpx solid #edf0e5;font-size:24rpx}.upcoming-row:last-child{padding-bottom:0;border:0}.future-period{display:block;font-size:21rpx;color:#9caa8b;margin-top:15rpx}.avatar-hint{display:block;font-size:19rpx;color:#abb59d;text-align:center;margin-top:25rpx}.card-notice{font-size:21rpx;color:#ab9174;background:#f4eee3;border-radius:14rpx;padding:24rpx;margin-top:22rpx}.claim{text-align:center}.claim-art{height:440rpx;position:relative;display:flex;align-items:center;justify-content:center}.art-ring{position:absolute;border:1rpx solid #dbe4cc;width:380rpx;height:380rpx;border-radius:50%}.sample-card{width:500rpx;transform:rotate(-8deg);background:linear-gradient(110deg,#015556,#027071);border-radius:24rpx;padding:36rpx;text-align:left;box-shadow:0 22rpx 35rpx #01555633;color:#fff}.sample-card>view{font-size:17rpx;letter-spacing:2rpx;display:flex;justify-content:space-between}.sample-card>view text{font-size:30rpx;line-height:1}.sample-title{font-size:35rpx;display:block;margin:38rpx 0 27rpx;letter-spacing:3rpx}.sample-sub{font-size:13rpx;letter-spacing:2rpx;opacity:.6}.claim .title{font-size:38rpx;margin:20rpx 0}.claim .subtitle{font-size:24rpx;line-height:1.9}.consent{display:flex;align-items:center;justify-content:center;margin:50rpx 0 22rpx;font-size:21rpx;color:#a2ad92}.consent label{display:flex;align-items:center}.consent checkbox{transform:scale(.7);margin-right:-3rpx}.consent>text{color:#015556}.claim .primary{margin-top:28rpx}.claim-note{display:block;font-size:18rpx;color:#acb79c;margin-top:24rpx}.contact{background:transparent;color:#015556;font-size:23rpx;margin:32rpx auto 0;line-height:2}
