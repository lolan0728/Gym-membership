page{background:#f7f8f2;color:#274535;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;box-sizing:border-box}view,text,button{box-sizing:border-box}button{font-size:27rpx;border-radius:16rpx}button::after{border:0}button.primary{background:#234f3c;color:#f4f7ea;font-size:27rpx;font-weight:500;line-height:3.1}button.secondary{background:#eaf0df;color:#587345;font-size:25rpx;line-height:3}button[disabled]{opacity:.45}.page{padding:44rpx 38rpx 70rpx}.eyebrow{font-size:17rpx;letter-spacing:3rpx;color:#8ea07b}.title{display:block;font-size:48rpx;font-weight:600;line-height:1.5;margin:14rpx 0 12rpx}.subtitle{display:block;font-size:24rpx;color:#96a189;line-height:1.8}.section{background:#fff;border:1rpx solid #e5e9df;border-radius:22rpx;padding:30rpx;margin-top:28rpx}.section-title{font-size:27rpx;font-weight:500;display:block;margin-bottom:24rpx}.muted{color:#9aa68f}.footer{font-size:17rpx;letter-spacing:3rpx;color:#acb59f;text-align:center;margin-top:64rpx}.error-box{padding:34rpx;border-radius:20rpx;background:#fff7f1;color:#a17f66;font-size:24rpx;line-height:1.8;margin:26rpx 0}.loading{padding:90rpx 10rpx;text-align:center;color:#a0ac92;font-size:25rpx}.row{display:flex;align-items:center;justify-content:space-between}.pill{display:inline-block;background:#edf3e6;color:#6e9254;font-size:20rpx;padding:7rpx 15rpx;border-radius:30rpx}.pill.expired,.pill.voided{background:#f1efea;color:#aa9d88}.pill.upcoming{background:#e9eff6;color:#768ca3}
.pill{display:inline-block;background:#21804a;color:#fff;font-size:21rpx;font-weight:700;line-height:1;padding:11rpx 18rpx;border-radius:30rpx;box-shadow:0 4rpx 10rpx #00000018}.pill.expired{background:#6b7280;color:#fff}.pill.voided{background:#b9363e;color:#fff}.pill.upcoming{background:#3975b7;color:#fff}