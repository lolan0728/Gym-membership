<view class="page"><view class="store-heading"><image wx:if="{{store.hasLogo}}" class="store-logo" src="{{logoUrl}}" mode="aspectFit"/><view wx:else class="mark">悦</view></view><view wx:if="loading" class="loading">正在打开你的会员卡…</view><view wx:elif="error"><view class="error-box">{{error}}</view><button class="primary" bindtap="refresh">重新加载</button><button class="contact" bindtap="contact">联系门店</button></view>
<block wx:elif="member"><view class="welcome"><view><text class="eyebrow">EVERY DAY IS A FRESH START</text><text class="title">你好，{{member.name}}</text><text class="subtitle">让每一次到店，都成为更好的开始。</text></view><button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" loading="{{avatarBusy}}" disabled="{{avatarBusy}}" aria-label="修改头像"><image wx:if="avatar" src="{{avatar}}" mode="aspectFill"/><text wx:else>{{initial}}</text><view class="avatar-edit">＋</view></button></view><member-card wx:if="{{card}}" theme="{{member.theme}}" store-name="{{store.name}}" name="{{member.name}}" card-number="{{member.card_number}}" kind="{{card.kindLabel}}" status="{{card.statusLabel}}" status-code="{{card.status}}" period="{{card.period}}"/><view wx:if="card && (card.status === 'expired' || card.status === 'voided')" class="card-notice">{{card.status==='expired'?'这张会员卡已到期，续卡请联系门店。':'这张会员卡已作废，详情请联系门店。'}}</view><view class="customize" bindtap="styles"><view><text class="custom-title">换个风格，继续热爱</text><text class="custom-sub">挑选属于你的会员卡样式</text></view><view class="color-dots"><view></view><view></view><view></view></view><text class="chevron">›</text></view><view class="section menu"><view class="menu-item" bindtap="history"><text>办卡记录</text><text>›</text></view><view class="menu-item" bindtap="contact"><text>联系门店</text><text>›</text></view><view class="menu-item" bindtap="privacy"><text>隐私说明</text><text>›</text></view></view><text class="avatar-hint">点击右上角头像，可以换成你喜欢的照片</text></block>
<view wx:else class="claim"><view class="claim-art"><view class="art-ring"></view><view class="sample-card"><view>JOYFIT MEMBER <text>悦</text></view><text class="sample-title">你的专属会员卡</text><text class="sample-sub">YOUR EVERYDAY, STRONGER.</text></view></view><text class="eyebrow">WELCOME TO JOYFIT</text><text class="title">每一次坚持，都有归属。</text><text class="subtitle">已在门店办理会员卡？
使用办理时登记的手机号，领取你的专属卡片。</text><view wx:if="!phoneReady" class="consent"><checkbox-group bindchange="toggleConsent"><label><checkbox checked="{{accepted}}" color="#235b49"/>我已阅读并同意</label></checkbox-group><text bindtap="privacy">《隐私说明》</text></view><button wx:if="!phoneReady" class="primary" loading="{{busy}}" disabled="{{!accepted || busy}}" bindtap="prepare">领取我的会员卡</button><button wx:else class="primary" open-type="getRealtimePhoneNumber" bindgetrealtimephonenumber="bindPhone" phone-number-no-quota-toast="{{false}}" loading="{{busy}}" disabled="{{busy}}">验证手机号并领取</button><text class="claim-note">仅用于匹配已办理的会员卡，不会自动注册或扣款</text><button class="contact" bindtap="contact">遇到问题？联系门店</button></view><view class="footer">YOUR EVERYDAY, STRONGER.</view></view>

<privacy-dialog id="privacy-dialog" />
