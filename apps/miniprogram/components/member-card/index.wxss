.card{position:relative;overflow:hidden;border-radius:30rpx;padding:40rpx 38rpx 30rpx;color:#ead69e;background:linear-gradient(115deg,#202925,#3d4031);box-shadow:0 22rpx 35rpx -18rpx #213c3255}.theme-blue{background:linear-gradient(110deg,#152b4b,#314e79);color:#d1def4}.theme-orange{background:linear-gradient(110deg,#db672e,#f39449);color:#fff2da}.theme-white{background:linear-gradient(110deg,#f5f1e9,#e8e8de);color:#424f44;box-shadow:none;border:1rpx solid #dbdfd1}.orbit{position:absolute;right:-170rpx;top:-90rpx;width:440rpx;height:440rpx;border-radius:50%;border:2rpx solid currentColor;opacity:.09}.two{right:-50rpx;top:55rpx;width:480rpx;height:480rpx}.top,.middle,.bottom,.period{display:flex;align-items:center;justify-content:space-between;position:relative;z-index:1}.brand{font-size:23rpx;max-width:70%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.membership{font-size:13rpx;letter-spacing:2rpx;opacity:.65}.middle{margin:44rpx 0 36rpx}.caption{font-size:13rpx;letter-spacing:2rpx;opacity:.6}.kind{font-size:46rpx;letter-spacing:5rpx;line-height:1.8}.kind text{font-size:15rpx;letter-spacing:3rpx;opacity:.55;margin-left:20rpx}.arrow{font-size:92rpx;opacity:.8;line-height:1}.name{display:block;font-size:23rpx}.number{display:block;font-size:16rpx;opacity:.6;margin-top:9rpx;letter-spacing:2rpx}.status{font-size:18rpx;padding:7rpx 16rpx;border:1rpx solid #ffffff40;border-radius:40rpx}.period{border-top:1rpx solid #ffffff25;padding-top:24rpx;margin-top:26rpx;font-size:17rpx;opacity:.7}
.status{font-size:21rpx;font-weight:700;line-height:1;padding:12rpx 20rpx;border:0;border-radius:40rpx;color:#fff;background:#52645b;box-shadow:0 5rpx 12rpx #00000022}.status-active{background:#21804a}.status-upcoming{background:#3975b7}.status-expired{background:#6b7280}.status-voided{background:#b9363e}