<view class="page"><text class="eyebrow">MAKE IT YOURS</text><text class="title">选一个你的风格</text><text class="subtitle">每种热爱，都有自己的颜色。</text><view wx:if="loading" class="loading">正在加载…</view><view wx:elif="error"><view class="error-box">{{error}}</view><button class="secondary" bindtap="load">重试</button></view><block wx:else><view class="preview"><member-card theme="{{theme}}" store-name="{{storeName}}" name="{{member.name}}" card-number="{{member.card_number}}" kind="{{card.kindLabel}}" status="{{card.statusLabel}}" status-code="{{card.status}}" period="{{card.period}}"/></view><view class="themes"><view wx:for="themes" wx:key="id" class="theme-option {{theme===item.id?'selected':''}}" data-id="{{item.id}}" bindtap="select"><view class="swatch {{item.id}}"><text>↗</text><text class="chosen" wx:if="theme===item.id">✓</text></view><text class="theme-name">{{item.name}}</text><text class="theme-hint">{{item.hint}}</text></view></view><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">保存这个风格</button><text class="save-note">仅改变卡片外观，你的会员权益保持不变。</text></block></view>

<privacy-dialog id="privacy-dialog" />
